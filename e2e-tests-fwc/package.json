{
  "name": "e2e-tests-fwc",
  "version": "1.0.0",
  "description": "end to end tests for the table games project",
  "main": "index.js",
  "scripts": {
    "test": "node node_modules/jest/bin/jest.js --silent=false --config ./test/jest-e2e.json",
    "test:debug": "node --inspect=9228 node_modules/jest/bin/jest.js --silent=false --config ./test/jest-e2e.json"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^29.*",
    "@types/jest": "^29.*",
    "@types/node": "^20.8.6",
    "@types/ws": "^8.5.7",
    "babel-jest": "^29.*",
    "jest": "^29.*",
    "ts-jest": "^29.*",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "rxjs": "^7.8.1",
    "ws": "^8.14.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
