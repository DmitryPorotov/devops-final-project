[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[android]
input_method = HiddenInputField

[project]
title = front-defold
version = 0.1.0
dependencies#0 = https://github.com/defold/extension-websocket/archive/3.1.0.zip

[display]
width = 1200
height = 675

[sprite]
max_count = 2048

[physics]
debug = 0

[html5]
heap_size = 512

[graphics]
default_texture_min_filter = nearest
max_draw_calls = 2048

[label]
max_count = 256

