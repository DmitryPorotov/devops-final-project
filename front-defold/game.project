[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[android]
input_method = HiddenInputField

[project]
title = front-defold
version = 0.1.0
dependencies#0 = https://github.com/defold/extension-websocket/archive/3.1.0.zip

[tilemap]
max_tile_count = 16384

[display]
width = 1200
height = 675

[sprite]
max_count = 2048

[physics]
debug = 0

[html5]
heap_size = 512

[collection]
max_instances = 2048
max_input_stack_entries = 32

[engine]
fixed_update_frequency = 30

