local tracks = require "main/ui/tracks"

function init(self)
	msg.post(".", "acquire_input_focus")
	self.tracks_open = false
	self.me = "moose"
	self.tracks = { 
		throne = {
			"moose",
			"lion",
			"wolf",
			"pufferfish",
			"kraken",
			"rose"
		},
		fiefdoms = {
			"kraken",
			"rose",
			"pufferfish",
			"wolf",
			"moose",
			"lion"
		},
		court = {
			"lion",
			"wolf",
			"pufferfish",
			"moose",
			"rose",
			"kraken"
		}
	}
	tracks:init(self.me)
	tracks:set_tracks(self.tracks)
end

