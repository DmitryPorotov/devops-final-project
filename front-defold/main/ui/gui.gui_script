local tracks = require "main/ui/tracks"
local top_panel = require "main/ui/top_panel"
local orders = require "main/ui/orders"
local login = require "main/ui/login/debug_login"
local supply_panel = require "main/ui/supply_panel"

local ws = require "main/messaging/websocket"
local mes_poc = require "main/messaging/message_processing"

function init(self)
	msg.post(".", "acquire_input_focus")
	login:init()

	ws:init()
	
	local function set_tracks(tracks_data)
		tracks:set_tracks(tracks_data)
	end
	mes_poc:set_set_tracks_cb(set_tracks)
	local function set_game_state(game_state)
		top_panel:set_game_state(game_state)
	end
	mes_poc:set_set_game_state_cb(set_game_state)
	local function set_players(players)
		tracks:set_players(players)
	end
	mes_poc:set_set_players_cb(set_players)
	local function calc_stars_available(court_track)
		orders:calc_stars_available(court_track)
	end
	mes_poc:set_calc_stars_available_cb(calc_stars_available)
	local function show_orders_on_map(orders_)
		orders:show_orders_on_map(orders_)
	end
	mes_poc:set_show_orders_on_map_cb(show_orders_on_map)

	self.tracks_open = false
	-- self.me = "kraken"
	-- self.players = {
	-- 	moose = { id = -1, name = "Waiting for player..." },
	-- 	lion = { id = -1, name = "Waiting for player..." },
	-- 	wolf = { id = -1, name = "Waiting for player..." },
	-- 	pufferfish = { id = -1, name = "Waiting for player..." },
	-- 	kraken = { id = -1, name = "Waiting for player..." },
	-- 	rose = { id = -1, name = "Waiting for player..." }
	-- }
	tracks:init()
	top_panel:init()
	orders:init()
	supply_panel:init()
	--tracks:set_tracks(self.tracks)
end

