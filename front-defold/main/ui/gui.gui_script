function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
	if message_id == hash("touch_multi") then
		local text = ""
		local sum = vmath.vector3()
		if #message.touch > 1 then
			sum = vmath.vector3(message.touch[1].dx + message.touch[2].dx, message.touch[1].dy + message.touch[2].dy, 0)
		end
		for i, touchdata in ipairs(message.touch) do
			text = text .. "point " .. i .. ' x ' .. touchdata.x .. ' y ' .. touchdata.y .. ' dx ' .. touchdata.dx .. ' dy ' .. touchdata.dy .. "\n"
		end
		text = text .. 'sum of deltas ' .. sum
		local s = gui.get_node("debug")
		gui.set_text(s, text)
	elseif message_id == hash("show_orders_menu") then
		orders:open(message.label, message.tile_num, message.deleted)
	end
end


function on_input(self, action_id, action)
	if login:on_input(action_id, action) then
		return true
	end
	if action_id == hash("touch") and action.pressed then
		if gui.pick_node(tracks.tracks, action.x, action.y) then
			if tracks.is_open then
				tracks:close()
				-- close_tracks(self, tracks)
			else
				tracks:open()
				-- open_tracks(self, tracks)
			end	
		elseif orders:get_button_pressed(action.x, action.y) then
			ws.send(orders:get_order_to_send())
			orders:add_order_to_map()
		end
	end
end

