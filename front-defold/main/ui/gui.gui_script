local tracks = require "main/ui/tracks"
local top_panel = require "main/ui/top_panel"
local orders = require "main/ui/orders"

local ws = require "main/ui/websocket"
local mes_poc = require "main/messaging/message_processing"

function init(self)
	msg.post(".", "acquire_input_focus")

	ws:init()
	mes_poc.set_set_tracks_cb(tracks, tracks.set_tracks)
	mes_poc.set_set_game_state_cb(top_panel, top_panel.set_game_state)

	self.tracks_open = false
	self.me = "lion"
	self.players = {
		moose = { id = 1, name = "player1" },
		lion = { id = 2, name = "player2" },
		wolf = { id = 3, name = "player3" },
		pufferfish = { id = 4, name = "player4" },
		kraken = { id = 5, name = "player5" },
		rose = { id = 6, name = "player6" }
	}
	tracks:init(self.me, self.players)
	top_panel:init()
	orders:init()
	--tracks:set_tracks(self.tracks)
end

function final(self)
	-- Add finalization code here
