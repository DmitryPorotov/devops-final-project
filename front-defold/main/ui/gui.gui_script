local gui_main = require "main/ui/gui_main"

function init(self)
	msg.post(".", "acquire_input_focus")
	gui_main:init()
end

function update(self, dt)
	gui_main:update(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("print_debug") then
		local s = gui.get_node("debug")
		gui.set_text(s, tostring(message.text))
	elseif message_id == hash("show_orders_menu") then
		gui_main:set_show_orders_menu_message(message)
	end
end


function on_input(self, action_id, action)
	if action_id == hash("touch") and gui_main:check_pressed(action.x, action.y) then
		msg.post('/camera', 'gui_click')
	end
	if action_id == hash("touch") and action.pressed then
		gui_main:set_action(action)
	end
	return true
end
