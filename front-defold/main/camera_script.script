local labels = require "main/labels"


local function draw_line(from, to)
	msg.post("@render:", "draw_line", { start_point = from, end_point = to, color = vmath.vector4(1,0,0,1) })
end

function init(self)
	msg.post("#camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")

	self.camera_move_dir = vmath.vector3()
	self.camera_drag_delta = vmath.vector3()
	self.camera_move_speed = 1000
	self.moving_camera = false

	self.camera_up_limit = vmath.vector3(0, 950, 0)
	self.camera_down_limit = vmath.vector3(0, -850, 0)

	-- self.camera_up_limit = vmath.vector3(2000, 2000, 0)
	-- self.camera_down_limit = vmath.vector3(-1000, -2000, 0)

	self.zoom = 1
	
	self.mouse_pressed = false
	self.try_selecting = false

	self.to = vmath.vector3()

	labels:init()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if self.moving_camera then
		local pos = go.get_position()         
		pos = pos + self.camera_move_dir * self.camera_move_speed * dt
		pos = pos - self.camera_drag_delta
		if pos.x < self.camera_down_limit.x then
			pos.x = self.camera_down_limit.x
		elseif pos.x > self.camera_up_limit.x then
			pos.x = self.camera_up_limit.x
		end
		if pos.y < self.camera_down_limit.y then
			pos.y = self.camera_down_limit.y
		elseif pos.y > self.camera_up_limit.y then
			pos.y = self.camera_up_limit.y
		end
		go.set_position(pos)                  
	end
	
	if self.try_selecting then
		local camera_pos = go.get_position()
		local to = self.to + camera_pos
		local from1 = to + vmath.vector3(0, 28, 0)
		local from2 = to + vmath.vector3(0, -28, 0)

		local result1 = physics.raycast(from1, to, { hash("label") })
		local result2 = physics.raycast(from2, to, { hash("label") })
		-- if result1 and result1 == result2 then
		if result1 and result2 and result1.id == result2.id then
			msg.post(result1.id, 'select')
			-- draw_line(from1, result1.position)
			-- draw_line(from2, result2.position)
		end
		self.try_selecting = false
	end

	self.moving_camera = false
	self.camera_move_dir = vmath.vector3()
end

