	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

local function add_zoom(self)
	if self.zoom >= 2 then
		return 2
	else 
		self.zoom = self.zoom + .1
		return self.zoom
	end
end

local function reduce_zoom(self)
	if self.zoom <= .5 then
		return .5
	else 
		self.zoom = self.zoom - .1
		return self.zoom
	end
end

function on_input(self, action_id, action)
	if action_id == hash("camera_up") then
		self.camera_move_dir.y = 1                       
	elseif action_id == hash("camera_down") then
		self.camera_move_dir.y = -1
	elseif action_id == hash("camera_left") then
		self.camera_move_dir.x = -1
	elseif action_id == hash("camera_right") then
		self.camera_move_dir.x = 1
	elseif action_id == hash("touch") and action.pressed then
		self.to.x = action.x
		self.to.y = action.y
		self.mouse_pressed = true
		self.try_selecting = true
	elseif action_id == hash("touch") and self.mouse_pressed and (action.dx ~= 0 or action.dy ~= 0) and not action.released then
		self.moving_camera = true
		self.camera_drag_delta = vmath.vector3(action.dx, action.dy, 0)
	elseif action_id == hash("touch") and action.released then
		self.mouse_pressed = false
	-- elseif action_id == hash("zoom_in") then
	-- 	go.animate("/map", "scale", go.PLAYBACK_ONCE_FORWARD, add_zoom(self), go.EASING_LINEAR, .5)
	-- elseif action_id == hash("zoom_out") then
	-- 	go.animate("/map", "scale", go.PLAYBACK_ONCE_FORWARD, reduce_zoom(self), go.EASING_LINEAR, .5)
	end

	if vmath.length(self.camera_move_dir) > 0 then
		self.moving_camera = true
		self.dir = vmath.normalize(self.camera_move_dir) 
	end
end

