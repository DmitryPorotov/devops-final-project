local labels = require "main/labels"
local utils = require "main/utils"
go.property("type", hash("knights"))
go.property("house", hash("lion"))

function init(self)
	sprite.play_flipbook("#sprite", utils.MIL_UNITS[self.type])
	go.set("#sprite", "tint", labels.HOUSE_COLORS[utils.HOUSES[self.house]])
	go.set_parent(nil, "/map")
end
