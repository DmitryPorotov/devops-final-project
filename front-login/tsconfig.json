{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "inlineSourceMap": true,
    "sourceRoot": "/home/dmitry/PhpstormProjects/table-games-monorepo/front-login/",
    "outDir": "./dist",
    "baseUrl": "./",
